{
    "openapi": "3.0.0",
    "info": {
        "title": "SkyBooker API",
        "description": "Flight Booking System API",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Local Server"
        }
    ],
    "paths": {
        "/api/v1/airports": {
            "get": {
                "tags": [
                    "Airports"
                ],
                "summary": "List all airports",
                "operationId": "9ddf9f315fec155948490be9412e77c1",
                "responses": {
                    "200": {
                        "description": "List of airports"
                    }
                }
            },
            "post": {
                "tags": [
                    "Airports"
                ],
                "summary": "Create a new airport",
                "operationId": "94aeba84c0acc64b9646bca51c4783e7",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code",
                                    "name",
                                    "city",
                                    "country",
                                    "terminals",
                                    "status"
                                ],
                                "properties": {
                                    "code": {
                                        "type": "string",
                                        "example": "AMS"
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Amsterdam Schiphol"
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "Amsterdam"
                                    },
                                    "country": {
                                        "type": "string",
                                        "example": "Netherlands"
                                    },
                                    "terminals": {
                                        "type": "integer",
                                        "example": 7
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "active"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Airport created successfully"
                    }
                }
            }
        },
        "/api/v1/airports/{code}": {
            "get": {
                "tags": [
                    "Airports"
                ],
                "summary": "Get airport by code",
                "operationId": "be0a4ce59f47bd4f4d637b00b9cb9941",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "description": "Airport code (3 letters)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "JFK"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Airport retrieved successfully"
                    },
                    "404": {
                        "description": "Airport not found"
                    }
                }
            },
            "put": {
                "tags": [
                    "Airports"
                ],
                "summary": "Update an airport",
                "operationId": "6135741a23a18316694ec3544592dec9",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "description": "Airport code (3 letters)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "JFK"
                        }
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "New Name"
                                    },
                                    "city": {
                                        "type": "string",
                                        "example": "New City"
                                    },
                                    "country": {
                                        "type": "string",
                                        "example": "New Country"
                                    },
                                    "terminals": {
                                        "type": "integer",
                                        "example": 10
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "maintenance"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Airport updated successfully"
                    },
                    "404": {
                        "description": "Airport not found"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Airports"
                ],
                "summary": "Delete an airport",
                "operationId": "2be788eae0c4617b3680ba745f2b0226",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "description": "Airport code (3 letters)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "JFK"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Airport deleted successfully"
                    },
                    "404": {
                        "description": "Airport not found"
                    }
                }
            }
        },
        "/api/v1/airports/search": {
            "get": {
                "tags": [
                    "Airports"
                ],
                "summary": "Search airports",
                "operationId": "16fa87d20c2250e968c03431bbc875d8",
                "parameters": [
                    {
                        "name": "code",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "name",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "city",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Search results"
                    }
                }
            }
        },
        "/api/v1/airports/{code}/flights": {
            "get": {
                "tags": [
                    "Airports"
                ],
                "summary": "Get all flights for an airport",
                "operationId": "f22b55ad38b45097cf210e97f5d5960f",
                "parameters": [
                    {
                        "name": "code",
                        "in": "path",
                        "description": "Airport code (3 letters)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "JFK"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of flights for the airport"
                    },
                    "404": {
                        "description": "Airport not found"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Airports",
            "description": "API Endpoints for managing airports"
        }
    ]
}